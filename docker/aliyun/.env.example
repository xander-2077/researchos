# Copy to docker/aliyun/.env and replace the example values.
# Values are read as data, never executed; shell environment overrides this file.
SERVER_NAME=research.example.com
# The cloud server's actual interface address; 192.0.2.10 is a documentation example.
PROXY_LISTEN_IP=192.0.2.10
PROXY_PORT=10001
TUNNEL_LOCAL_USER=researcher
TUNNEL_SSH_HOST=research-server
# SSH remote port binds to 127.0.0.1 on the cloud server.
TUNNEL_PORT=10001
TUNNEL_TARGET_HOST=127.0.0.1
# Match the local application's RESEARCHOS_PORT.
TUNNEL_TARGET_PORT=8000

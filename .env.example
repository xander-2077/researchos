# Copy to .env and adjust. All variables are optional except the admin password on first start.

# --- First start: creates the admin user if none exists (min 10 chars). You can remove it afterwards
# and manage the password with:  docker compose exec researchos python -m app.cli set-password
RESEARCHOS_ADMIN_USERNAME=admin
RESEARCHOS_ADMIN_PASSWORD=change-me-to-a-long-password

# --- Network (docker compose port binding). Keep 127.0.0.1 unless behind a firewall/VPN.
RESEARCHOS_BIND=127.0.0.1
RESEARCHOS_PORT=8000

# --- Security
# Session signing key. If unset, a random key is generated and stored in the data volume.
# RESEARCHOS_SECRET_KEY=
# Set to true when served over HTTPS (reverse proxy / Tailscale Serve) so cookies are Secure-only.
RESEARCHOS_COOKIE_SECURE=false
# Cross-origin browser access (JSON list). Empty = same-origin only (recommended).
RESEARCHOS_CORS_ORIGINS=[]
# Optional Host-header allow-list for the MCP endpoint (DNS-rebinding protection), e.g.
# ["research.example.com","research.example.com:443"]. Bearer tokens are always required.
RESEARCHOS_MCP_ALLOWED_HOSTS=[]
RESEARCHOS_RATE_LIMIT_PER_MINUTE=600
RESEARCHOS_LOGIN_RATE_LIMIT_PER_MINUTE=10
RESEARCHOS_MAX_BODY_BYTES=1000000
RESEARCHOS_SESSION_MAX_AGE_DAYS=14

# --- Storage (inside the container; the docker volume is mounted at /data)
# RESEARCHOS_DATA_DIR=/data
# RESEARCHOS_DATABASE_URL=sqlite:////data/researchos.db

# --- Build: PyPI mirror for `docker compose build` (default: Tsinghua TUNA).
# Outside mainland China you may prefer the official index:
# PIP_INDEX_URL=https://pypi.org/simple

# --- Tailscale remote access (optional): docker compose --profile tailscale up -d
# Machine name in your tailnet → https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=researchos
# Optional pre-auth key (tskey-auth-...). Leave empty to log in via the URL printed in
# `docker compose logs tailscale`. Remove it after the first successful start.
TS_AUTHKEY=
# Include the sidecar in every `docker compose` command (so `up -d --build` also manages it):
# COMPOSE_PROFILES=tailscale
